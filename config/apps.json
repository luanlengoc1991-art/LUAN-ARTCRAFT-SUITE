        "repo": "https://github.com/storytold/photocraft.git",
        "branch": "main",
        "importedCommit": "c699e3cda69f4852b43c0b191ab0091aaeff9d6a",
        "importMethod": "git subtree --squash"
      },
      "license": "MIT OR Apache-2.0",
      "licenseFiles": [
        "LICENSE-MIT",
        "LICENSE-APACHE",
        "NOTICE"
      ],
      "language": "Rust",
      "rustVersion": "1.95",
      "version": "0.9.0",
      "build": {
        "buildByDefault": true,
        "packages": [
          "photocraft",
          "photocraft-cli"
        ],
        "features": [
          "heif"
        ],
        "windowsPackager": "packaging/windows/package.ps1",
        "binaries": [
          "photocraft.exe",
          "photocraft-cli.exe"
        ]
      },
      "automation": {
        "cli": "photocraft-cli",
        "mcp": "photocraft-cli mcp",
        "mcpTransport": "stdio (JSON-RPC 2.0)",
        "controlChannel": "TCP 127.0.0.1:<port> (JSON lines), bridged by mcp --connect/--bridge/--attach"
