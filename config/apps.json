{
  "$comment": "Source of truth for the 13 ArtCraft apps in this monorepo. upstream.importedCommit is updated by scripts/upstream-update.ps1. dependsOnApps: cross-app crates pulled by Cargo from GitHub at a pinned rev (NOT from apps/<other>/ on disk).",
  "sharedUpstreamLibraries": {
    "craft-libs": "https://github.com/storytold/craft-libs (pulled by Cargo as pinned git deps; not vendored)",
    "craft-fonts": "https://github.com/storytold/craft-fonts"
